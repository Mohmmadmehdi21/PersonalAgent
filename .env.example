GROQ_API_KEY=your_groq_api_key
# Currently supported Groq text + vision model; override with another account-enabled model if needed.
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Number of retries after the initial attempt (0-5); transient errors only.
GROQ_MAX_RETRIES=3
# Optional, separate Google Agent Platform ADC configuration (not used by the current Groq pipeline).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
VERTEX_AI_MODEL=
GOOGLE_APPLICATION_CREDENTIALS=
# Kam clips, zyada quality (default 2, max 4)
CLIPS_PER_DAY=2
# Minimum viral hook score (1-10) to include a clip
HOOK_MIN_SCORE=7
# vertical = Shorts (9:16), horizontal = normal 16:9 video
ORIENTATION=vertical
SLOT_HOURS_IST=9,13,17,21
WHISPER_MODEL=base
# false = automatic YouTube upload; true = local preview only
DRY_RUN=false
# Legacy setting retained for compatibility; uploadLimitExceeded always stops retries.
UPLOAD_LIMIT_GUARD_ENABLED=false

# Value-Add / Original Commentary Settings
# Modes: text_only | text_tts | voice | face
COMMENTARY_MODE=text_tts
# Edge-TTS voices: en-US-GuyNeural, en-US-AriaNeural, hi-IN-MadhurNeural, hi-IN-SwaraNeural
TTS_VOICE=en-US-GuyNeural

# Own video ratio: 1 own video every OWN_RATIO uploads (placed in own_videos/)
OWN_RATIO=3
# Leave disabled to process the configured source channel automatically
OWN_CONTENT_ENABLED=false

# Notifications (telegram | email | none, or comma-separated: telegram,email)
NOTIFY_CHANNEL=none
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated owner Telegram numeric user IDs; required for `python main.py telegram-bot`.
TELEGRAM_OWNER_IDS=
# Optional; when true, send only major pipeline milestones to TELEGRAM_CHAT_ID.
TELEGRAM_PROGRESS_ENABLED=false

# Email SMTP Settings (optional, Gmail App Password required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# Disk Safai / Cleanup Policy
CLEANUP=true
KEEP_TRANSCRIPT=true
KEEP_FINAL_CLIPS_DAYS=2
DELETE_SOURCE=true

# Reliability & Retries
MAX_RETRIES=3
API_TIMEOUT_SECONDS=30

# YouTube yt-dlp Download & Resilience Settings
YTDLP_MAX_RETRIES=2
YTDLP_RATE_LIMIT_COOLDOWN_SECONDS=900
YTDLP_MAX_SOURCE_CANDIDATES=5
YTDLP_DOWNLOAD_TIMEOUT_SECONDS=120
# Optional authenticated cookies: path to exported cookies.txt file
# Export your own legitimate cookies using official browser guidance / cookies.txt export
YTDLP_COOKIES_FILE=
# Optional browser name to extract cookies from directly (e.g. chrome, firefox, edge)
YTDLP_COOKIES_FROM_BROWSER=

# Optional growth tools (all disabled by default)
TRACKING_ENABLED=false
MIN_SAMPLES_PER_SLOT=8
CANDIDATE_HOURS_IST=7,8,11,12,15,16,18,19,20,22
AUTO_SLOT_UPDATE=false
LEARNING_ENABLED=false
COMMENT_ENABLED=false
HEALTH_MAX_HOURS=26
GROWTH_HEALTH_ENABLED=false
SHEET_ID=

# Optional scheduler (runs only inside the single Telegram bot process; no public upload is scheduled).
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_SOURCE_REFRESH_ENABLED=false
SCHEDULER_SOURCE_REFRESH_TIME=08:00
SCHEDULER_PREPARE_TIME=09:00
DAILY_DRAFT_LIMIT=2
SCHEDULER_ANALYTICS_ENABLED=false
SCHEDULER_ANALYTICS_TIME=10:00
SCHEDULER_ANALYTICS_RANGE=7d
SCHEDULER_MAX_ATTEMPTS=2
SCHEDULER_RETRY_DELAY_MINUTES=30

# Duplicate Guard Settings
GUARD_ENABLED=true
MAX_CLIPS_PER_VIDEO=4
MIN_GAP_SEC=10
GUARD_COUNT_DRY_RUN=false

# Source Video Filter Settings
SOURCE_FILTER_ENABLED=true
MIN_SOURCE_DURATION_SEC=480

# Persistent Source Rejection Memory & Selection Settings
REJECT_MEMORY_ENABLED=true
TRANSIENT_COOLDOWN_HOURS=12
MAX_TRANSIENT_ATTEMPTS=5
MAX_CHANNEL_PAGES=3
SOURCE_PICK_MODE=ordered


