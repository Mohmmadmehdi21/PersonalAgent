GEMINI_API_KEY=your_free_key_from_aistudio.google.com
# AI Studio mein dekho kaun sa Flash model free hai, aur yahan naam daalo
GEMINI_MODEL=gemini-2.5-flash
CLIPS_PER_DAY=4
# vertical = Shorts (9:16), horizontal = normal 16:9 video (custom thumbnail yahi dikhta hai)
ORIENTATION=vertical
WHISPER_MODEL=small
